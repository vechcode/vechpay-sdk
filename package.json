{
  "name": "@vechcode/vechpay-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for VechPay Payment Gateway",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --format esm && bun build index.ts --outdir dist --target node --format cjs && bun run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "vechpay",
    "payment",
    "gateway",
    "stripe",
    "xendit",
    "midtrans",
    "doku",
    "sdk"
  ],
  "license": "MIT",
  "private": true
}